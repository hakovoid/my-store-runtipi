{
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json",
  "services": [
    {
      "name": "metabolic-log",
      "image": "ghcr.io/hakovoid/metabolic-log:0.19.0",
      "isMain": true,
      "internalPort": 3000,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "environment": [
        { "key": "DB_KEY", "value": "{DB_KEY}" },
        { "key": "ANTHROPIC_API_KEY", "value": "{ANTHROPIC_API_KEY}" },
        { "key": "OPENAI_API_KEY", "value": "{OPENAI_API_KEY}" },
        { "key": "OLLAMA_URL", "value": "{OLLAMA_URL}" }
      ]
    }
  ]
}
